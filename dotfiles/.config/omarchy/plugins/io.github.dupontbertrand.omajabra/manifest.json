{
  "schemaVersion": 1,
  "id": "io.github.dupontbertrand.omajabra",
  "name": "Omajabra",
  "version": "0.1.0",
  "author": "Bertrand Dupont",
  "description": "Jabra battery, connection, and audio controls in the Omarchy bar.",
  "license": "MIT",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omajabra",
    "description": "Jabra battery, connection, and audio controls",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showBattery": true,
      "hideWhenDisconnected": false
    },
    "schema": [
      {
        "key": "showBattery",
        "type": "boolean",
        "label": "Show battery percent in the bar",
        "defaultValue": true
      },
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide the icon when no Jabra is connected",
        "defaultValue": false
      }
    ]
  }
}
