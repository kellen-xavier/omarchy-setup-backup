# Derived Omarchy theme output — 100% regenerated by selecting the theme
# again (theme.name is what actually needs to be versioned, kept below).
dotfiles/.config/omarchy/current/theme/
dotfiles/.config/omarchy/current/background
!dotfiles/.config/omarchy/current/theme.name

# Pure copies of the theme above (real configs are symlinks into
# omarchy/current/theme/*; export.sh's `cp -L` dereferences them into
# identical duplicate files with zero custom content)
dotfiles/.config/mako/config
dotfiles/.config/btop/themes/current.theme

# Runtime cache, not config — fcitx5 regenerates this on its own
dotfiles/.config/fcitx5/conf/cached_layouts

# Backups install.sh/export.sh create when overwriting existing files
*.bak
*.bak.*
*.pre-restore.bak

# Editor / OS junk
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Safety net: never let a secret slip into this (public) repo, even by accident
*.pem
*.key
id_rsa*
.env
.netrc
*_token
*token*.txt
